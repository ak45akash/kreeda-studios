# Public site URL for metadata
NEXT_PUBLIC_SITE_URL=https://kreedastudios.com

# --- Contact form delivery (pick one) ---

# Option A — Resend (recommended on Vercel)
# 1. Create an account at https://resend.com
# 2. Create an API key
# 3. For testing, leave CONTACT_FROM_EMAIL unset (uses onboarding@resend.dev)
# 4. For production, verify your domain and set CONTACT_FROM_EMAIL
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@yourdomain.com
# CONTACT_FROM_EMAIL="Kreeda Studios <hello@yourdomain.com>"

# Option B — Formspree / Getform / custom webhook
# CONTACT_FORM_ENDPOINT=https://formspree.io/f/your-form-id
# CONTACT_FORM_API_KEY=
